# KHU App — Environment Variables Template
# Copy this file to ".env" and fill in real values.
# NEVER commit the actual ".env" file to GitHub — it's already in .gitignore.

# Admin PDF fixture upload — required to use POST /api/admin/fixtures/upload-pdf
# Generate any long random string, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_TOKEN="your-long-random-admin-token-here"

# Browser login for admin.html (POST /api/admin/login). Both required, or
# admin login answers 503. After 5 failed attempts an IP is locked out for 15 min.
ADMIN_USERNAME="your-admin-username"
ADMIN_PASSWORD="a-long-unique-password"

# Comma-separated Vercel/custom-domain origins allowed to call the API.
# If unset, CORS allows every origin ("*") — fine locally, not in production.
ALLOWED_ORIGINS="https://your-app.vercel.app"

# Agent accounts live in SQLite, which Render wipes on cold start. Paste the
# "agents" JSON from GET /api/admin/agents/export-seed here (one line) to
# restore them automatically. Contains password hashes — keep it secret.
AGENTS_SEED=""

# Push Notifications (Web Push / VAPID)
#
# IMPORTANT: VAPID_PRIVATE_KEY_RAW_B64URL must be the RAW private key
# bytes, base64url-encoded — NOT a PEM block with "-----BEGIN..." headers.
# Generate a correct keypair with:
#
#   python -c "
#   from py_vapid import Vapid02
#   import base64
#   v = Vapid02(); v.generate_keys()
#   raw = v.private_key.private_numbers().private_value.to_bytes(32, 'big')
#   print('PRIVATE:', base64.urlsafe_b64encode(raw).decode().rstrip('='))
#   pub = v.public_key.public_bytes(
#       encoding=__import__('cryptography.hazmat.primitives.serialization', fromlist=['Encoding']).Encoding.X962,
#       format=__import__('cryptography.hazmat.primitives.serialization', fromlist=['PublicFormat']).PublicFormat.UncompressedPoint
#   )
#   print('PUBLIC:', base64.urlsafe_b64encode(pub).decode().rstrip('='))
#   "
VAPID_PRIVATE_KEY_RAW_B64URL="your-raw-base64url-private-key-here"
VAPID_PUBLIC_KEY_B64URL="your-public-key-here"
VAPID_CONTACT_EMAIL="your-email@example.com"

# ── Scraping cadence / politeness (optional — sensible defaults built in) ──
# KHU's host serves browser-verification interstitials ("One moment,
# please...") to automated clients from time to time. Slowing the scraper
# down is both good manners and the most effective way to stay under
# bot-protection. All three are read from the environment at startup.

# Seconds between requests to kenyahockeyunion.org (default 1.0).
# Raise to 2-3 if the backend logs show repeated interstitial warnings.
KHU_REQUEST_DELAY_SECONDS="1.0"

# Multiplier applied to the delay for 15 minutes after an interstitial is
# seen (default 3 — i.e. 3s instead of 1s above).
KHU_CHALLENGE_BACKOFF_MULTIPLIER="3"

# Minutes between background refreshes (default 15). Raise to 30 to halve
# total request volume (~70-90 requests per cycle).
KHU_REFRESH_INTERVAL_MINUTES="15"

# ── Live-watch (optional) ──
# On match days a small scrape of ONLY today's teams runs every N minutes so
# live scores and finals show quickly. The full refresh still runs every 15.
# KHU_LIVE_WATCH_MINUTES=2    # 0 switches live-watch off

# ── Database and backups (optional) ──
# DB_POOL_MAX=5               # max Postgres connections (Supabase pooler)
# BACKUP_S3_REGION=auto       # region for the off-site backup bucket (R2 uses "auto")

# ── Auto-delete hand-made edits once KHU catches up (optional) ──
# A manual result or match correction is deleted automatically when KHU's own
# site shows the SAME score for 2 full refreshes in a row. A different score is
# kept and flagged in the admin results list. Results that carry goal scorers
# or cards are kept (KHU does not publish those).
# KHU_AUTO_RETIRE=1          # set to 0 to switch it off
# KHU_RETIRE_CYCLES=2        # agreeing refreshes needed before deleting

# ── Security (optional) ──
# Reverse proxies in front of the app (Render = 1). Used to read the real client IP.
TRUSTED_PROXY_HOPS="1"
# Set to 1 only while developing: exposes /docs and /openapi.json.
KHU_ENABLE_DOCS=""
# Set to 1 to write raw scraped pages to disk when a parse fails (debugging only).
KHU_DEBUG_DUMP=""

# OPTIONAL — durable database (Supabase / any PostgreSQL). When set, the app
# stores everything in Postgres instead of the local SQLite file, so scores and
# agent accounts survive Render restarts. Use Supabase's *Session pooler*
# connection string (Project > Connect), with your database password filled in
# (percent-encode special characters). Leave unset to keep using SQLite.
# ── Off-site nightly backup (any S3-compatible bucket: Cloudflare R2, Backblaze B2) ──
# BACKUP_S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# BACKUP_S3_BUCKET="khu-backups"
# BACKUP_S3_KEY_ID=""
# BACKUP_S3_SECRET=""
# BACKUP_S3_PREFIX="khu-backups"

# ── Shop payments: M-Pesa (Safaricom Daraja). Leave unset and the shop shows "Ordering opens soon". ──
# Step-by-step: docs/SHOP_SETUP.md. Start with MPESA_ENV=sandbox; switch to production only after testing.
# MPESA_ENV="sandbox"                       # or "production"
# MPESA_CONSUMER_KEY=""
# MPESA_CONSUMER_SECRET=""
# MPESA_SHORTCODE="174379"                  # your paybill / till (sandbox: 174379)
# MPESA_PARTY_B=""                         # tills only: the till number that receives the money (SHORTCODE is then the store/head-office number)
# MPESA_PASSKEY=""                          # Lipa Na M-Pesa Online passkey
# MPESA_TRANSACTION_TYPE="CustomerPayBillOnline"   # use CustomerBuyGoodsOnline for a till
# MPESA_CALLBACK_SECRET=""                  # long random string; part of the secret callback URL
# PUBLIC_API_URL="https://khu-backend.onrender.com"

# ── Edge layer (Cloudflare Worker in front of the API): docs/EDGE_SETUP.md ──
# MPESA_CALLBACK_BASE="https://khu-edge.<you>.workers.dev"   # Safaricom reports payments to the Worker
# EDGE_KEY=""    # same secret as the Worker's. When set, ONLY the Worker may call /api/*. Delete it to switch the lock off.

# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-us-west-2.pooler.supabase.com:5432/postgres"
