# KHU App — Environment Variables Template
# Copy this file to ".env" and fill in real values.
# NEVER commit the actual ".env" file to GitHub — it's already in .gitignore.

# Admin PDF fixture upload — required to use POST /api/admin/fixtures/upload-pdf
# Generate any long random string, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_TOKEN="your-long-random-admin-token-here"

# Push Notifications (Web Push / VAPID)
#
# IMPORTANT: VAPID_PRIVATE_KEY_RAW_B64URL must be the RAW private key
# bytes, base64url-encoded — NOT a PEM block with "-----BEGIN..." headers.
# Generate a correct keypair with:
#
#   python -c "
#   from py_vapid import Vapid02
#   import base64
#   v = Vapid02(); v.generate_keys()
#   raw = v.private_key.private_numbers().private_value.to_bytes(32, 'big')
#   print('PRIVATE:', base64.urlsafe_b64encode(raw).decode().rstrip('='))
#   pub = v.public_key.public_bytes(
#       encoding=__import__('cryptography.hazmat.primitives.serialization', fromlist=['Encoding']).Encoding.X962,
#       format=__import__('cryptography.hazmat.primitives.serialization', fromlist=['PublicFormat']).PublicFormat.UncompressedPoint
#   )
#   print('PUBLIC:', base64.urlsafe_b64encode(pub).decode().rstrip('='))
#   "
VAPID_PRIVATE_KEY_RAW_B64URL="your-raw-base64url-private-key-here"
VAPID_PUBLIC_KEY_B64URL="your-public-key-here"
VAPID_CONTACT_EMAIL="your-email@example.com"

# ── Scraping cadence / politeness (optional — sensible defaults built in) ──
# KHU's host serves browser-verification interstitials ("One moment,
# please...") to automated clients from time to time. Slowing the scraper
# down is both good manners and the most effective way to stay under
# bot-protection. All three are read from the environment at startup.

# Seconds between requests to kenyahockeyunion.org (default 1.0).
# Raise to 2-3 if the backend logs show repeated interstitial warnings.
KHU_REQUEST_DELAY_SECONDS="1.0"

# Multiplier applied to the delay for 15 minutes after an interstitial is
# seen (default 3 — i.e. 3s instead of 1s above).
KHU_CHALLENGE_BACKOFF_MULTIPLIER="3"

# Minutes between background refreshes (default 15). Raise to 30 to halve
# total request volume (~70-90 requests per cycle).
KHU_REFRESH_INTERVAL_MINUTES="15"
