/backend/database.py               @Geoduor
/backend/dbconn.py                 @Geoduor
/backend/backup.py                 @Geoduor
/backend/push.py                   @Geoduor
/frontend/khu-frontend/public/admin.html          @Geoduor
/frontend/khu-frontend/public/agent.html          @Geoduor
/frontend/khu-frontend/public/service-worker.js   @Geoduor

# Cloudflare Worker (rate limits, human check, payment callback, cache)
/edge/                             @Geoduor

# Deployment, security headers and dependencies (a changed dependency can carry hidden code)
